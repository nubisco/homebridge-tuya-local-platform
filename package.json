{
  "name": "@nubisco/homebridge-tuya-local-platform",
  "version": "1.4.0",
  "description": "Homebridge plugin to control Tuya devices locally over LAN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/homebridge-tuya-local-platform.git"
  },
  "author": "José Silva <jose@nubisco.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nubisco/homebridge-tuya-local-platform/issues"
  },
  "homepage": "https://github.com/nubisco/homebridge-tuya-local-platform#readme",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homebridge-tuya-local-platform",
    "tuya",
    "tuya-lan",
    "local"
  ],
  "engines": {
    "homebridge": ">=1.6.0",
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "types:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm test && npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npm run lint:fix",
      "npm run format"
    ],
    "tests/**/*.ts": "npm run format",
    "*.{json,md,mts,mjs}": "npm run format"
  },
  "dependencies": {
    "async": "^3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/async": "^3.2.24",
    "@types/node": "^20.19.37",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^1.11.2",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  }
}
